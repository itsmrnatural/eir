# Environment variables of the Health Centre system. Copy to .env.
# --- data layer -------------------------------------------------------------------------------------
DATABASE_URL=postgres://hc:hc_password@localhost:5432/health_centre   # inside compose: host "postgres"
MONGO_URL=mongodb://localhost:27017                                    # inside compose: host "mongo"
MONGO_DB=health_centre
DUPLICATE_VISIT_WINDOW_MIN=10
# --- server ------------------------------------------------------------------------------------------
JWT_SECRET=change-me-in-production
PORT=4000
CORS_ORIGIN=http://localhost:5173
# --- client ------------------------------------------------------------------------------------------
# VITE_API_BASE_URL=http://localhost:4000/api/v1
# --- what the postgres container itself needs (official image variables; used by db/backup/*.sh via docker compose exec)
POSTGRES_USER=hc
POSTGRES_PASSWORD=hc_password
POSTGRES_DB=health_centre
